# Frontend configuration only. Every VITE_* value is embedded in the browser bundle,
# so it is public. Never put Gemini, Groq, or any other private secret here.
VITE_SITE_BASE=/
VITE_CHAT_ENDPOINT=https://your-worker.example.workers.dev/api/chat
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
